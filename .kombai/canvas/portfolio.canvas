      "html": "<style data-kid=\"0\">\n  @import url('https://fonts.googleapis.com/css2?family=Michroma&family=Share+Tech+Mono&display=swap');\n\n  :root {\n    --color-void: #000000;\n    --color-optical: #050505;\n    --color-phosphor: #E0E0E0;\n    --color-target: #FF003C;\n    --color-sensor: #00E5FF;\n    --color-radar: #FFB000;\n  }\n\n  body {\n    background-color: var(--color-void);\n    color: var(--color-phosphor);\n    font-family: 'Share Tech Mono', monospace;\n    margin: 0;\n    cursor: crosshair;\n  }\n\n  .font-heading { font-family: 'Michroma', sans-serif; }\n  .font-mono { font-family: 'Share Tech Mono', monospace; }\n\n  .scanlines {\n    position: fixed;\n    top: 0; left: 0; width: 100%; height: 100%;\n    pointer-events: none;\n    z-index: 50;\n    background: repeating-linear-gradient(\n      to bottom,\n      transparent,\n      transparent 2px,\n      rgba(0, 0, 0, 0.3) 2px,\n      rgba(0, 0, 0, 0.3) 4px\n    );\n    opacity: 0.1;\n  }\n\n  .liquid-glass {\n    background: rgba(10, 10, 10, 0.8);\n    backdrop-filter: blur(40px);\n    border: 1px solid rgba(0, 229, 255, 0.1);\n    box-shadow: \n      inset 0 1px 1px rgba(224, 224, 224, 0.1),\n      0 10px 30px -10px rgba(0, 0, 0, 0.5);\n    transition: all 0.4s cubic-bezier(0.4, 0, 0.2, 1);\n  }\n\n  .liquid-glass:hover {\n    border-color: rgba(0, 229, 255, 0.4);\n    transform: translateY(-4px);\n    box-shadow: \n      inset 0 1px 2px rgba(0, 229, 255, 0.2),\n      0 20px 40px -15px rgba(0, 229, 255, 0.1);\n  }\n\n  .ripple-bg {\n    position: absolute;\n    inset: 0;\n    overflow: hidden;\n    z-index: -1;\n    background-image: url('https://images.unsplash.com/photo-1529753253655-470be9a42781?auto=format&w=1440&q=80&fit=crop');\n    background-size: cover;\n    background-position: center;\n  }\n\n  .ripple-overlay {\n    position: absolute;\n    inset: 0;\n    background: radial-gradient(circle at 50% 50%, transparent 0%, var(--color-void) 70%);\n    mix-blend-mode: multiply;\n  }\n\n  @keyframes ripple {\n    0% { transform: scale(1) translate(0, 0); opacity: 0.3; }\n    50% { transform: scale(1.1) translate(-1%, 1%); opacity: 0.5; }\n    100% { transform: scale(1) translate(0, 0); opacity: 0.3; }\n  }\n\n  .ripple-circle {\n    position: absolute;\n    width: 600px;\n    height: 600px;\n    background: radial-gradient(circle, rgba(0, 229, 255, 0.05) 0%, transparent 70%);\n    filter: blur(60px);\n    animation: ripple 10s infinite ease-in-out;\n  }\n\n  .text-glow {\n    text-shadow: 0 0 10px rgba(0, 229, 255, 0.3);\n  }\n\n  .target-corner {\n    position: absolute;\n    width: 12px;\n    height: 12px;\n    border-color: var(--color-sensor);\n    opacity: 0.4;\n  }\n</style>\n\n<div class=\"scanlines\" data-kid=\"1\"></div>\n\n<div class=\"relative min-h-screen overflow-hidden\" data-kid=\"2\">\n  \n  <div class=\"ripple-bg\" data-kid=\"3\">\n    <div class=\"ripple-overlay\" data-kid=\"4\"></div>\n    <div class=\"ripple-circle\" style=\"top: 10%; left: 20%;\" data-kid=\"5\"></div>\n    <div class=\"ripple-circle\" style=\"bottom: 20%; right: 10%; animation-delay: -5s;\" data-kid=\"6\"></div>\n  </div>\n\n  \n  <nav class=\"fixed top-0 w-full z-40 border-b border-white/5 backdrop-blur-md bg-void/50\" data-kid=\"7\">\n    <div class=\"max-w-7xl mx-auto px-6 h-16 flex items-center justify-between\" data-kid=\"8\">\n      <div class=\"font-heading text-lg tracking-widest text-sensor flex items-center gap-3\" data-kid=\"9\">\n        <div class=\"w-8 h-8 border border-sensor flex items-center justify-center\" data-kid=\"10\">\n          <div class=\"w-1 h-1 bg-sensor\" data-kid=\"11\"></div>\n        </div>\n        PRASUN.SYS\n      </div>\n      <div class=\"hidden md:flex gap-8 font-mono text-xs uppercase tracking-widest\" data-kid=\"12\">\n        <a href=\"#\" class=\"text-phosphor hover:text-sensor transition-colors flex items-center gap-2\" data-kid=\"13\">\n          <span class=\"text-target\" data-kid=\"14\">01.</span>MISSION\n        </a>\n        <a href=\"#\" class=\"text-phosphor/60 hover:text-sensor transition-colors flex items-center gap-2\" data-kid=\"15\">\n          <span class=\"text-target\" data-kid=\"16\">02.</span>ARSENAL\n        </a>\n        <a href=\"#\" class=\"text-phosphor/60 hover:text-sensor transition-colors flex items-center gap-2\" data-kid=\"17\">\n          <span class=\"text-target\" data-kid=\"18\">03.</span>OPS\n        </a>\n        <a href=\"#\" class=\"text-phosphor/60 hover:text-sensor transition-colors flex items-center gap-2\" data-kid=\"19\">\n          <span class=\"text-target\" data-kid=\"20\">04.</span>UPLINK\n        </a>\n      </div>\n    </div>\n  </nav>\n\n  \n  <section class=\"pt-32 pb-20 px-6\" data-kid=\"21\">\n    <div class=\"max-w-7xl mx-auto\" data-kid=\"22\">\n      <div class=\"liquid-glass p-12 max-w-3xl relative overflow-hidden\" data-kid=\"23\">\n        <div class=\"absolute top-0 right-0 p-4 font-mono text-[10px] text-sensor/40 opacity-50\" data-kid=\"24\">\n          SECURE_PROTOCOL: ENABLED<br data-kid=\"25\">\n          ENCRYPTION: AES-256\n        </div>\n        \n        <div class=\"mb-4 text-sensor font-mono tracking-widest text-sm flex items-center gap-2\" data-kid=\"26\">\n          <span class=\"w-2 h-[1px] bg-sensor\" data-kid=\"27\"></span>\n          INITIATING COMMAND INTERFACE\n        </div>\n        \n        <h1 class=\"font-heading text-5xl md:text-6xl mb-6 tracking-tighter text-glow leading-none\" data-kid=\"28\">\n          ENGINEERING<br data-kid=\"29\">\n          <span class=\"text-sensor\" data-kid=\"30\">THE FUTURE</span>\n        </h1>\n        \n        <p class=\"text-phosphor/70 max-w-xl mb-10 text-lg leading-relaxed\" data-kid=\"31\">\n          Aerospace engineer specializing in tactical UAV systems, autonomous flight mechanics, and edge-AI deployment. Building high-refraction solutions for low-visibility environments.\n        </p>\n        \n        <div class=\"flex flex-wrap gap-4\" data-kid=\"32\">\n          <button class=\"px-8 py-3 bg-sensor text-void font-heading text-xs tracking-widest hover:bg-target hover:text-white transition-all\" data-kid=\"33\">\n            VIEW_DOSSIER\n          </button>\n          <button class=\"px-8 py-3 border border-sensor/30 text-sensor font-heading text-xs tracking-widest hover:border-sensor hover:bg-sensor/5 transition-all\" data-kid=\"34\">\n            MISSION_LOGS\n          </button>\n        </div>\n      </div>\n    </div>\n  </section>\n\n  \n  <section class=\"py-20 px-6 bg-void/30\" data-kid=\"35\">\n    <div class=\"max-w-7xl mx-auto\" data-kid=\"36\">\n      <div class=\"flex items-end justify-between mb-12 border-b border-white/5 pb-4\" data-kid=\"37\">\n        <div data-kid=\"38\">\n          <h2 class=\"font-heading text-2xl text-sensor\" data-kid=\"39\">CLASSIFIED_ARCHIVE</h2>\n          <p class=\"font-mono text-xs text-phosphor/40 mt-1 uppercase tracking-widest\" data-kid=\"40\">Targeting mission-critical deployments</p>\n        </div>\n        <div class=\"font-mono text-xs text-target\" data-kid=\"41\">[ STATUS: OPTIMAL ]</div>\n      </div>\n\n      <div class=\"grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8\" data-kid=\"42\">\n        \n        <div class=\"liquid-glass group relative flex flex-col h-full\" data-kid=\"43\">\n          <div class=\"h-48 relative overflow-hidden border-b border-white/5 bg-void/50\" data-kid=\"44\">\n            <img src=\"https://images.unsplash.com/photo-1669295384050-a1d4357bd1d7?auto=format&w=800&q=80\" class=\"w-full h-full object-cover opacity-40 group-hover:opacity-60 transition-opacity\" decoding=\"async\" loading=\"lazy\" data-kid=\"45\">\n            <div class=\"absolute inset-0 bg-gradient-to-t from-[#0a0a0a] to-transparent\" data-kid=\"46\"></div>\n            <div class=\"absolute bottom-4 left-4 font-mono text-[10px] text-sensor border border-sensor/20 px-2 py-1\" data-kid=\"47\">\n              AEROSPACE_DIV\n            </div>\n          </div>\n          \n          <div class=\"p-6 flex flex-col flex-grow relative\" data-kid=\"48\">\n            \n            <div class=\"absolute top-0 left-0 border-t-2 border-l-2 w-3 h-3 border-sensor/30\" data-kid=\"49\"></div>\n            <div class=\"absolute top-0 right-0 border-t-2 border-r-2 w-3 h-3 border-sensor/30\" data-kid=\"50\"></div>\n            <div class=\"absolute bottom-0 left-0 border-b-2 border-l-2 w-3 h-3 border-sensor/30\" data-kid=\"51\"></div>\n            <div class=\"absolute bottom-0 right-0 border-b-2 border-r-2 w-3 h-3 border-sensor/30\" data-kid=\"52\"></div>\n\n            <h3 class=\"font-heading text-lg mb-3 group-hover:text-sensor transition-colors\" data-kid=\"53\">Boeing Aeromodelling</h3>\n            <p class=\"text-phosphor/50 text-sm mb-6 flex-grow leading-relaxed\" data-kid=\"54\">\n              Design and structural optimization of competitive RC aircraft with high-capacity payload capabilities.\n            </p>\n            \n            <div class=\"flex flex-wrap gap-2 mt-auto\" data-kid=\"55\">\n              <span class=\"text-[10px] font-mono border border-white/10 px-2 py-1 text-phosphor/40 group-hover:border-sensor/30 transition-colors\" data-kid=\"56\">CFD_SIM</span>\n              <span class=\"text-[10px] font-mono border border-white/10 px-2 py-1 text-phosphor/40 group-hover:border-sensor/30 transition-colors\" data-kid=\"57\">CAD_V5</span>\n            </div>\n          </div>\n        </div>\n\n        \n        <div class=\"liquid-glass group relative flex flex-col h-full\" data-kid=\"58\">\n          <div class=\"h-48 relative overflow-hidden border-b border-white/5 bg-void/50\" data-kid=\"59\">\n            <img src=\"https://images.unsplash.com/photo-1708778002477-75611274f23d?auto=format&w=800&q=80\" class=\"w-full h-full object-cover opacity-40 group-hover:opacity-60 transition-opacity\" decoding=\"async\" loading=\"lazy\" data-kid=\"60\">\n            <div class=\"absolute inset-0 bg-gradient-to-t from-[#0a0a0a] to-transparent\" data-kid=\"61\"></div>\n            <div class=\"absolute bottom-4 left-4 font-mono text-[10px] text-sensor border border-sensor/20 px-2 py-1\" data-kid=\"62\">\n              HARDWARE_SEC\n            </div>\n          </div>\n          \n          <div class=\"p-6 flex flex-col flex-grow relative\" data-kid=\"63\">\n            <div class=\"absolute top-0 left-0 border-t-2 border-l-2 w-3 h-3 border-sensor/30\" data-kid=\"64\"></div>\n            <div class=\"absolute top-0 right-0 border-t-2 border-r-2 w-3 h-3 border-sensor/30\" data-kid=\"65\"></div>\n            <div class=\"absolute bottom-0 left-0 border-b-2 border-l-2 w-3 h-3 border-sensor/30\" data-kid=\"66\"></div>\n            <div class=\"absolute bottom-0 right-0 border-b-2 border-r-2 w-3 h-3 border-sensor/30\" data-kid=\"67\"></div>\n\n            <h3 class=\"font-heading text-lg mb-3 group-hover:text-sensor transition-colors\" data-kid=\"68\">Wi-Fi Sentinel</h3>\n            <p class=\"text-phosphor/50 text-sm mb-6 flex-grow leading-relaxed\" data-kid=\"69\">\n              Network Intrusion Detection System built on ESP32 architecture for anomaly monitoring in secure sectors.\n            </p>\n            \n            <div class=\"flex flex-wrap gap-2 mt-auto\" data-kid=\"70\">\n              <span class=\"text-[10px] font-mono border border-white/10 px-2 py-1 text-phosphor/40 group-hover:border-sensor/30 transition-colors\" data-kid=\"71\">ESP32</span>\n              <span class=\"text-[10px] font-mono border border-white/10 px-2 py-1 text-phosphor/40 group-hover:border-sensor/30 transition-colors\" data-kid=\"72\">CYBER_TAD</span>\n            </div>\n          </div>\n        </div>\n\n        \n        <div class=\"liquid-glass group relative flex flex-col h-full\" data-kid=\"73\">\n          <div class=\"h-48 relative overflow-hidden border-b border-white/5 bg-void/50\" data-kid=\"74\">\n            <img src=\"https://images.unsplash.com/photo-1707730376818-a7a02fe896d5?auto=format&w=800&q=80\" class=\"w-full h-full object-cover opacity-40 group-hover:opacity-60 transition-opacity\" decoding=\"async\" loading=\"lazy\" data-kid=\"75\">\n            <div class=\"absolute inset-0 bg-gradient-to-t from-[#0a0a0a] to-transparent\" data-kid=\"76\"></div>\n            <div class=\"absolute bottom-4 left-4 font-mono text-[10px] text-sensor border border-sensor/20 px-2 py-1\" data-kid=\"77\">\n              INTEL_AI\n            </div>\n          </div>\n          \n          <div class=\"p-6 flex flex-col flex-grow relative\" data-kid=\"78\">\n            <div class=\"absolute top-0 left-0 border-t-2 border-l-2 w-3 h-3 border-sensor/30\" data-kid=\"79\"></div>\n            <div class=\"absolute top-0 right-0 border-t-2 border-r-2 w-3 h-3 border-sensor/30\" data-kid=\"80\"></div>\n            <div class=\"absolute bottom-0 left-0 border-b-2 border-l-2 w-3 h-3 border-sensor/30\" data-kid=\"81\"></div>\n            <div class=\"absolute bottom-0 right-0 border-b-2 border-r-2 w-3 h-3 border-sensor/30\" data-kid=\"82\"></div>\n\n            <h3 class=\"font-heading text-lg mb-3 group-hover:text-sensor transition-colors\" data-kid=\"83\">Local LLM Infra</h3>\n            <p class=\"text-phosphor/50 text-sm mb-6 flex-grow leading-relaxed\" data-kid=\"84\">\n              Private AI inference pipeline using Ollama and Llama 3 on local hardware for edge telemetry processing.\n            </p>\n            \n            <div class=\"flex flex-wrap gap-2 mt-auto\" data-kid=\"85\">\n              <span class=\"text-[10px] font-mono border border-white/10 px-2 py-1 text-phosphor/40 group-hover:border-sensor/30 transition-colors\" data-kid=\"86\">PY_KERN</span>\n              <span class=\"text-[10px] font-mono border border-white/10 px-2 py-1 text-phosphor/40 group-hover:border-sensor/30 transition-colors\" data-kid=\"87\">LLM_OLLAMA</span>\n            </div>\n          </div>\n        </div>\n      </div>\n    </div>\n  </section>\n\n  \n  <sectio