      "html": "<style data-kid=\"0\">\n  @import url('https://fonts.googleapis.com/css2?family=Michroma&family=Share+Tech+Mono&display=swap');\n\n  :root {\n    --void: #000000;\n    --optical: #050505;\n    --phosphor: #E0E0E0;\n    --target: #FF003C;\n    --radar: #FFB000;\n    --sensor: #00E5FF;\n  }\n\n  .font-heading { font-family: 'Michroma', sans-serif; }\n  .font-mono { font-family: 'Share Tech Mono', monospace; }\n\n  /* Liquid Glass Core */\n  .glass-pane {\n    @apply relative overflow-hidden backdrop-blur-3xl border border-white/10;\n    background: linear-gradient(135deg, rgba(5, 5, 5, 0.7) 0%, rgba(0, 0, 0, 0.4) 100%);\n  }\n\n  /* Animated Thermal Blobs */\n  .thermal-blob {\n    @apply absolute blur-[100px] opacity-40 mix-blend-screen pointer-events-none;\n    animation: blob-float 15s infinite alternate ease-in-out;\n  }\n\n  @keyframes blob-float {\n    0% { transform: translate(-10%, -10%) scale(1); }\n    100% { transform: translate(15%, 20%) scale(1.3); }\n  }\n\n  /* Scanline Overlay */\n  .scanlines {\n    position: fixed;\n    top: 0;\n    left: 0;\n    width: 100vw;\n    height: 100vh;\n    pointer-events: none;\n    z-index: 50;\n    background: repeating-linear-gradient(\n      to bottom,\n      rgba(255, 255, 255, 0),\n      rgba(255, 255, 255, 0) 2px,\n      rgba(0, 0, 0, 0.2) 2px,\n      rgba(0, 0, 0, 0.2) 4px\n    );\n    opacity: 0.15;\n    mix-blend-mode: overlay;\n  }\n\n  /* Custom HUD Button */\n  .btn-hud {\n    @apply inline-flex items-center justify-center px-8 py-3 border border-target/50 text-target font-mono uppercase tracking-[0.2em] transition-all duration-300;\n    background: linear-gradient(to right, rgba(255, 0, 60, 0.05), transparent);\n  }\n  .btn-hud:hover {\n    @apply border-target bg-target/10 shadow-[0_0_20px_rgba(255,0,60,0.3)];\n    transform: translateY(-2px);\n  }\n\n  /* Target Box corners */\n  .target-corner {\n    @apply absolute w-4 h-4 border-target border-t-2 border-l-2 opacity-60 transition-all duration-300;\n  }\n\n  .glass-card:hover .target-corner {\n    @apply w-6 h-6 opacity-100;\n  }\n\n  .thermal-bg-video {\n    @apply absolute inset-0 w-full h-full object-cover opacity-30 mix-blend-lighten;\n  }\n</style>\n\n<div class=\"bg-void min-h-screen text-phosphor font-mono relative cursor-crosshair overflow-x-hidden\" data-kid=\"1\">\n  <div class=\"scanlines\" data-kid=\"2\"></div>\n\n  \n  <div class=\"fixed inset-0 overflow-hidden pointer-events-none z-0\" data-kid=\"3\">\n    <div class=\"thermal-blob w-[600px] h-[600px] bg-target -top-20 -left-20\" data-kid=\"4\"></div>\n    <div class=\"thermal-blob w-[500px] h-[500px] bg-radar bottom-0 -right-20\" style=\"animation-delay: -5s;\" data-kid=\"5\"></div>\n  </div>\n\n  \n  <header class=\"relative min-h-screen flex items-center justify-center overflow-hidden border-b border-target/20\" data-kid=\"6\">\n    <video src=\"https://videos.pexels.com/video-files/6033520/6033520-sd_240_426_30fps.mp4\" poster=\"https://images.pexels.com/videos/6033520/caliente-casting-jewellery-6033520.jpeg?auto=compress&cs=tinysrgb&fit=crop&h=1200&w=630\" autoplay muted loop playsinline class=\"thermal-bg-video\" data-kid=\"7\"></video>\n    \n    <div class=\"absolute inset-0 bg-void/60 backdrop-blur-sm\" data-kid=\"8\"></div>\n\n    <div class=\"relative z-10 text-center px-4 max-w-4xl\" data-kid=\"9\">\n      <div class=\"inline-block mb-4 px-3 py-1 border border-target/30 bg-target/10 text-target text-xs tracking-widest uppercase animate-pulse\" data-kid=\"10\">\n        System Status: Optimal // Thermal Link Established\n      </div>\n      <h1 class=\"text-6xl md:text-8xl font-heading mb-6 tracking-tighter leading-none\" data-kid=\"11\">\n        THERMAL <span class=\"text-target\" data-kid=\"12\">OPTICS</span>\n      </h1>\n      <p class=\"text-lg md:text-xl text-phosphor/60 mb-10 max-w-2xl mx-auto uppercase tracking-widest leading-relaxed\" data-kid=\"13\">\n        Next-gen aerospace interfaces. Engineering the intersection of <span class=\"text-radar\" data-kid=\"14\">Heat</span> & <span class=\"text-sensor\" data-kid=\"15\">Logic</span>.\n      </p>\n      <div class=\"flex flex-col sm:flex-row gap-6 justify-center\" data-kid=\"16\">\n        <a href=\"#projects\" class=\"btn-hud\" data-kid=\"17\">Initiate Scan</a>\n        <a href=\"#contact\" class=\"btn-hud border-sensor/50 text-sensor hover:bg-sensor/10 hover:border-sensor hover:shadow-[0_0_20px_rgba(0,229,255,0.3)]\" data-kid=\"18\">Establish Contact</a>\n      </div>\n    </div>\n\n    \n    <div class=\"absolute bottom-10 left-10 text-[10px] text-phosphor/40 space-y-1\" data-kid=\"19\">\n      <div data-kid=\"20\">LAT: 20.2961° N</div>\n      <div data-kid=\"21\">LONG: 85.8245° E</div>\n      <div class=\"text-target\" data-kid=\"22\">GRID_REF: CU-T-M_01</div>\n    </div>\n  </header>\n\n  \n  <section id=\"projects\" class=\"py-32 relative\" data-kid=\"23\">\n    <div class=\"container mx-auto px-6\" data-kid=\"24\">\n      <div class=\"mb-20\" data-kid=\"25\">\n        <h2 class=\"text-3xl font-heading mb-4 inline-flex items-center\" data-kid=\"26\">\n          <span class=\"text-target mr-3\" data-kid=\"27\">03.</span> OPERATIONAL_ARCHIVE\n        </h2>\n        <div class=\"h-px bg-gradient-to-right from-target/50 to-transparent w-full\" data-kid=\"28\"></div>\n      </div>\n\n      <div class=\"grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-10\" data-kid=\"29\">\n        \n        <div class=\"glass-card glass-pane p-8 group transition-all duration-500 hover:-translate-y-2\" data-kid=\"30\">\n          \n          <div class=\"absolute -inset-20 bg-target/20 blur-[60px] opacity-0 group-hover:opacity-100 transition-opacity duration-700 pointer-events-none\" data-kid=\"31\"></div>\n          \n          <div class=\"target-corner top-0 left-0\" data-kid=\"32\"></div>\n          <div class=\"target-corner top-0 right-0 rotate-90\" data-kid=\"33\"></div>\n          <div class=\"target-corner bottom-0 left-0 -rotate-90\" data-kid=\"34\"></div>\n          <div class=\"target-corner bottom-0 right-0 rotate-180\" data-kid=\"35\"></div>\n\n          <div class=\"relative z-10\" data-kid=\"36\">\n            <div class=\"mb-6 h-48 bg-black/40 border border-white/5 flex items-center justify-center overflow-hidden relative\" data-kid=\"37\">\n               <i class=\"ti ti-cpu text-target/30 text-6xl group-hover:scale-110 transition-transform\" data-kid=\"38\"></i>\n               <div class=\"absolute bottom-2 left-2 text-[10px] font-mono text-white/20\" data-kid=\"39\">IMG_REF: AERO_01</div>\n            </div>\n            <h3 class=\"text-xl font-heading mb-3 text-white group-hover:text-target transition-colors\" data-kid=\"40\">Boeing Aeromodelling</h3>\n            <p class=\"text-phosphor/60 text-sm mb-6 leading-relaxed\" data-kid=\"41\">\n              RC aircraft optimization for payload capacity and stability. Tactical deployment readiness.\n            </p>\n            <div class=\"flex flex-wrap gap-2 mb-8\" data-kid=\"42\">\n              <span class=\"px-2 py-0.5 bg-target/10 border border-target/20 text-[10px] text-target uppercase\" data-kid=\"43\">Aerodynamics</span>\n              <span class=\"px-2 py-0.5 bg-radar/10 border border-radar/20 text-[10px] text-radar uppercase\" data-kid=\"44\">RC Design</span>\n            </div>\n            <a href=\"#\" class=\"text-xs tracking-widest text-phosphor/40 hover:text-white transition-colors flex items-center gap-2\" data-kid=\"45\">\n              ACCESS DATA <i class=\"ti ti-arrow-right\" data-kid=\"46\"></i>\n            </a>\n          </div>\n        </div>\n\n        \n        <div class=\"glass-card glass-pane p-8 group transition-all duration-500 hover:-translate-y-2\" data-kid=\"47\">\n          <div class=\"absolute -inset-20 bg-radar/20 blur-[60px] opacity-0 group-hover:opacity-100 transition-opacity duration-700 pointer-events-none\" data-kid=\"48\"></div>\n          \n          <div class=\"target-corner top-0 left-0\" data-kid=\"49\"></div>\n          <div class=\"target-corner top-0 right-0 rotate-90\" data-kid=\"50\"></div>\n          <div class=\"target-corner bottom-0 left-0 -rotate-90\" data-kid=\"51\"></div>\n          <div class=\"target-corner bottom-0 right-0 rotate-180\" data-kid=\"52\"></div>\n\n          <div class=\"relative z-10\" data-kid=\"53\">\n            <div class=\"mb-6 h-48 bg-black/40 border border-white/5 flex items-center justify-center\" data-kid=\"54\">\n               <i class=\"ti ti-flare text-radar/30 text-6xl group-hover:scale-110 transition-transform\" data-kid=\"55\"></i>\n            </div>\n            <h3 class=\"text-xl font-heading mb-3 text-white group-hover:text-radar transition-colors\" data-kid=\"56\">FPV Drone Fleet</h3>\n            <p class=\"text-phosphor/60 text-sm mb-6 leading-relaxed\" data-kid=\"57\">\n              6S power setups and Tiny Whoops. PID controller tuning for aggressive thermal-scouting flight.\n            </p>\n            <div class=\"flex flex-wrap gap-2 mb-8\" data-kid=\"58\">\n              <span class=\"px-2 py-0.5 bg-target/10 border border-target/20 text-[10px] text-target uppercase\" data-kid=\"59\">Electronics</span>\n              <span class=\"px-2 py-0.5 bg-radar/10 border border-radar/20 text-[10px] text-radar uppercase\" data-kid=\"60\">Betaflight</span>\n            </div>\n            <a href=\"#\" class=\"text-xs tracking-widest text-phosphor/40 hover:text-white transition-colors flex items-center gap-2\" data-kid=\"61\">\n              ACCESS DATA <i class=\"ti ti-arrow-right\" data-kid=\"62\"></i>\n            </a>\n          </div>\n        </div>\n\n        \n        <div class=\"glass-card glass-pane p-8 group transition-all duration-500 hover:-translate-y-2\" data-kid=\"63\">\n          <div class=\"absolute -inset-20 bg-target/20 blur-[60px] opacity-0 group-hover:opacity-100 transition-opacity duration-700 pointer-events-none\" data-kid=\"64\"></div>\n          \n          <div class=\"target-corner top-0 left-0\" data-kid=\"65\"></div>\n          <div class=\"target-corner top-0 right-0 rotate-90\" data-kid=\"66\"></div>\n          <div class=\"target-corner bottom-0 left-0 -rotate-90\" data-kid=\"67\"></div>\n          <div class=\"target-corner bottom-0 right-0 rotate-180\" data-kid=\"68\"></div>\n\n          <div class=\"relative z-10\" data-kid=\"69\">\n            <div class=\"mb-6 h-48 bg-black/40 border border-white/5 flex items-center justify-center\" data-kid=\"70\">\n               <i class=\"ti ti-device-computer-camera text-target/30 text-6xl group-hover:scale-110 transition-transform\" data-kid=\"71\"></i>\n            </div>\n            <h3 class=\"text-xl font-heading mb-3 text-white group-hover:text-target transition-colors\" data-kid=\"72\">Wi-Fi Sentinel</h3>\n            <p class=\"text-phosphor/60 text-sm mb-6 leading-relaxed\" data-kid=\"73\">\n              ESP32-based Network Intrusion Detection System. Real-time thermal anomaly network mapping.\n            </p>\n            <div class=\"flex flex-wrap gap-2 mb-8\" data-kid=\"74\">\n              <span class=\"px-2 py-0.5 bg-target/10 border border-target/20 text-[10px] text-target uppercase\" data-kid=\"75\">Security</span>\n              <span class=\"px-2 py-0.5 bg-radar/10 border border-radar/20 text-[10px] text-radar uppercase\" data-kid=\"76\">ESP32</span>\n            </div>\n            <a href=\"#\" class=\"text-xs tracking-widest text-phosphor/40 hover:text-white transition-colors flex items-center gap-2\" data-kid=\"77\">\n              ACCESS DATA <i class=\"ti ti-arrow-right\" data-kid=\"78\"></i>\n            </a>\n          </div>\n        </div>\n      </div>\n    </div>\n  </section>\n\n  \n  <footer class=\"py-12 border-t border-target/20 bg-optical/80 backdrop-blur-md\" data-kid=\"79\">\n    <div class=\"container mx-auto px-6 flex flex-col md:flex-row justify-between items-center gap-8\" data-kid=\"80\">\n      <div class=\"font-heading text-sm tracking-widest\" data-kid=\"81\">\n        PRASUN <span class=\"text-target\" data-kid=\"82\">K. BISWAS</span> // 2026\n      </div>\n      \n      <div class=\"flex gap-10 text-[10px] font-mono tracking-[0.3em] uppercase opacity-60\" data-kid=\"83\">\n        <a href=\"#\" class=\"hover:text-target transition-colors\" data-kid=\"84\">Link:Github</a>\n        <a href=\"#\" class=\"hover:text-target transition-colors\" data-kid=\"85\">Link:Linkedin</a>\n        <a href=\"#\" class=\"hover:text-target transition-colors\" data-kid=\"86\">Status:200_OK</a>\n      </div>\n    </div>\n  </footer>\n</div>\n\n\n<link rel=\"stylesheet\" href=\"https://cdn.jsdelivr.net/npm/@tabler/icons-webfont/tabler-icons.min.css\" data-kid=\"87\">",
