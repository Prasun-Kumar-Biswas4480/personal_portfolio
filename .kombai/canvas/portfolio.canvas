      "html": "<style data-kid=\"0\">\n  @import url('https://fonts.googleapis.com/css2?family=Michroma&family=Share+Tech+Mono&display=swap');\n\n  :root {\n    --color-void: #000000;\n    --color-optical: #050505;\n    --color-phosphor: #E0E0E0;\n    --color-target: #FF003C;\n    --color-radar: #FFB000;\n    --color-sensor: #00E5FF;\n    --font-heading: 'Michroma', sans-serif;\n    --font-body: 'Share Tech Mono', monospace;\n  }\n\n  body {\n    margin: 0;\n    padding: 0;\n    background-color: var(--color-void);\n    color: var(--color-phosphor);\n    font-family: var(--font-body);\n    cursor: crosshair;\n    overflow-x: hidden;\n  }\n\n  .scanlines {\n    position: fixed;\n    top: 0;\n    left: 0;\n    width: 100vw;\n    height: 100vh;\n    pointer-events: none;\n    z-index: 50;\n    background: repeating-linear-gradient(\n      to bottom,\n      rgba(255, 255, 255, 0),\n      rgba(255, 255, 255, 0) 2px,\n      rgba(0, 0, 0, 0.2) 2px,\n      rgba(0, 0, 0, 0.2) 4px\n    );\n    opacity: 0.15;\n    mix-blend-mode: overlay;\n  }\n\n  .target-box {\n    position: relative;\n    background-color: transparent;\n    transition: all 0.3s ease;\n    background-image: \n      linear-gradient(to right, var(--color-sensor) 2px, transparent 2px),\n      linear-gradient(to bottom, var(--color-sensor) 2px, transparent 2px),\n      linear-gradient(to left, var(--color-sensor) 2px, transparent 2px),\n      linear-gradient(to bottom, var(--color-sensor) 2px, transparent 2px),\n      linear-gradient(to right, var(--color-sensor) 2px, transparent 2px),\n      linear-gradient(to top, var(--color-sensor) 2px, transparent 2px),\n      linear-gradient(to left, var(--color-sensor) 2px, transparent 2px),\n      linear-gradient(to top, var(--color-sensor) 2px, transparent 2px);\n    background-position: 0 0, 0 0, 100% 0, 100% 0, 0 100%, 0 100%, 100% 100%, 100% 100%;\n    background-repeat: no-repeat;\n    background-size: 16px 16px;\n  }\n\n  .target-box:hover {\n    transform: scale(1.02);\n    background-color: var(--color-optical);\n    box-shadow: inset 0 0 20px rgba(255, 0, 60, 0.05);\n    background-image: \n      linear-gradient(to right, var(--color-target) 2px, transparent 2px),\n      linear-gradient(to bottom, var(--color-target) 2px, transparent 2px),\n      linear-gradient(to left, var(--color-target) 2px, transparent 2px),\n      linear-gradient(to bottom, var(--color-target) 2px, transparent 2px),\n      linear-gradient(to right, var(--color-target) 2px, transparent 2px),\n      linear-gradient(to top, var(--color-target) 2px, transparent 2px),\n      linear-gradient(to left, var(--color-target) 2px, transparent 2px),\n      linear-gradient(to top, var(--color-target) 2px, transparent 2px);\n    background-size: 24px 24px;\n    z-index: 10;\n  }\n\n  .btn-hud {\n    display: inline-flex;\n    align-items: center;\n    justify-content: center;\n    padding: 0.5rem 1.5rem;\n    border: 1px solid var(--color-sensor);\n    color: var(--color-sensor);\n    background-color: transparent;\n    transition: all 0.3s ease;\n    text-transform: uppercase;\n    letter-spacing: 0.1em;\n    font-size: 0.875rem;\n    text-decoration: none;\n  }\n\n  .btn-hud:hover {\n    background-color: rgba(255, 0, 60, 0.1);\n    border-color: var(--color-target);\n    color: var(--color-target);\n  }\n\n  h1, h2, h3, h4 {\n    font-family: var(--font-heading);\n    text-transform: uppercase;\n    letter-spacing: 0.2em;\n    color: var(--color-sensor);\n  }\n\n  .section-index {\n    color: var(--color-target);\n    margin-right: 0.5rem;\n  }\n\n  .phosphor-muted {\n    color: rgba(224, 224, 224, 0.6);\n  }\n\n  .h-px-fade {\n    height: 1px;\n    background: linear-gradient(to right, #1f2937, transparent);\n    width: 100%;\n    max-width: 320px;\n  }\n</style>\n\n<div class=\"scanlines\" data-kid=\"1\"></div>\n\n<div class=\"min-h-screen selection:bg-target/30 selection:text-white\" data-kid=\"2\">\n  \n  <nav class=\"fixed top-0 left-0 w-full z-40 bg-void/80 backdrop-blur-md border-b border-sensor/10\" data-kid=\"3\">\n    <div class=\"max-w-7xl mx-auto px-6 h-20 flex items-center justify-between\" data-kid=\"4\">\n      <div class=\"font-heading text-lg text-sensor tracking-[0.3em]\" data-kid=\"5\">PRASUN<span class=\"text-target\" data-kid=\"6\">_</span>HUD</div>\n      <div class=\"hidden md:flex items-center gap-10\" data-kid=\"7\">\n        <a href=\"#about\" class=\"text-xs uppercase tracking-widest hover:text-target transition-colors\" data-kid=\"8\">01. About</a>\n        <a href=\"#skills\" class=\"text-xs uppercase tracking-widest hover:text-target transition-colors\" data-kid=\"9\">02. Skills</a>\n        <a href=\"#projects\" class=\"text-xs uppercase tracking-widest hover:text-target transition-colors\" data-kid=\"10\">03. Projects</a>\n        <a href=\"#contact\" class=\"text-xs uppercase tracking-widest hover:text-target transition-colors\" data-kid=\"11\">04. Contact</a>\n        <a href=\"#\" class=\"btn-hud\" data-kid=\"12\">Resume</a>\n      </div>\n    </div>\n  </nav>\n\n  \n  <section class=\"min-h-screen flex items-center justify-center pt-20\" data-kid=\"13\">\n    <div class=\"max-w-7xl mx-auto px-6 grid grid-cols-1 lg:grid-cols-2 gap-12 items-center\" data-kid=\"14\">\n      <div data-kid=\"15\">\n        <div class=\"inline-block py-1 px-3 border border-sensor/30 text-[10px] uppercase tracking-widest text-sensor mb-6\" data-kid=\"16\">\n          System Initialized // Aerospace Engineering\n        </div>\n        <h1 class=\"text-4xl md:text-6xl font-bold leading-tight mb-6\" data-kid=\"17\">\n          Prasun Kumar <br data-kid=\"18\"> \n          <span class=\"text-white\" data-kid=\"19\">Biswas</span><span class=\"text-target animate-pulse\" data-kid=\"20\">_</span>\n        </h1>\n        <p class=\"text-lg phosphor-muted max-w-xl mb-10 leading-relaxed\" data-kid=\"21\">\n          Multidisciplinary engineer specializing in the intersection of <span class=\"text-white\" data-kid=\"22\">Aerospace systems</span>, <span class=\"text-white\" data-kid=\"23\">Hardware design</span>, and <span class=\"text-white\" data-kid=\"24\">Local AI deployment</span>. Engineering the future from the ground up.\n        </p>\n        <div class=\"flex flex-wrap gap-4\" data-kid=\"25\">\n          <a href=\"#projects\" class=\"btn-hud py-4 px-8\" data-kid=\"26\">View Operations</a>\n          <a href=\"#contact\" class=\"px-8 py-4 text-xs uppercase tracking-widest border border-transparent hover:border-sensor/20 transition-all\" data-kid=\"27\">Establish Connection</a>\n        </div>\n      </div>\n      <div class=\"relative hidden lg:block\" data-kid=\"28\">\n        <div class=\"target-box aspect-square flex items-center justify-center\" data-kid=\"29\">\n           <div class=\"w-full h-full bg-sensor/5 flex items-center justify-center opacity-40\" data-kid=\"30\">\n             <i class=\"fa-solid fa-microchip text-8xl text-sensor\" data-kid=\"31\"></i>\n           </div>\n           <div class=\"absolute inset-0 bg-gradient-to-br from-target/5 to-transparent\" data-kid=\"32\"></div>\n        </div>\n        \n        <div class=\"absolute -top-4 -right-4 w-24 h-px bg-sensor/30\" data-kid=\"33\"></div>\n        <div class=\"absolute -top-4 -right-4 w-px h-24 bg-sensor/30\" data-kid=\"34\"></div>\n        <div class=\"absolute -bottom-8 -left-8 text-[10px] font-mono text-sensor/40 vertical-rl tracking-[0.5em]\" data-kid=\"35\">\n          DATA_STREAM // ACTIVE // 0XF29\n        </div>\n      </div>\n    </div>\n  </section>\n\n  \n  <section id=\"about\" class=\"py-24 target-box mx-6 md:mx-20\" data-kid=\"36\">\n    <div class=\"max-w-7xl mx-auto px-6\" data-kid=\"37\">\n      <div class=\"mb-16\" data-kid=\"38\">\n        <h2 class=\"text-3xl font-bold flex items-center\" data-kid=\"39\">\n          <span class=\"section-index\" data-kid=\"40\">01.</span> About Me\n        </h2>\n        <div class=\"h-px-fade mt-4\" data-kid=\"41\"></div>\n      </div>\n\n      <div class=\"grid grid-cols-1 lg:grid-cols-2 gap-16 items-start\" data-kid=\"42\">\n        <div class=\"space-y-6 phosphor-muted text-lg leading-relaxed\" data-kid=\"43\">\n          <p data-kid=\"44\">\n            I am a multidisciplinary engineer studying at <span class=\"text-white\" data-kid=\"45\">Centurion University of Technology and Management (CUTM)</span>. \n            My journey began with a fascination for flight and evolved into a deep dive into the systems that make autonomous and intelligent machines possible.\n          </p>\n          <p data-kid=\"46\">\n            My core philosophy centers around building from the ground up. Whether it's designing the physical airframe of a drone, soldering the flight controller, or deploying a local LLM to process telemetry data, I thrive at the intersection of hardware and software.\n          </p>\n          <p data-kid=\"47\">\n            I don't just write code; I engineer systems that interact with the physical world.\n          </p>\n        </div>\n\n        <div class=\"grid grid-cols-1 sm:grid-cols-2 gap-6\" data-kid=\"48\">\n          <div class=\"p-8 border border-sensor/20 hover:border-sensor/50 transition-all bg-optical/30\" data-kid=\"49\">\n            <i class=\"fa-solid fa-plane text-target text-2xl mb-4\" data-kid=\"50\"></i>\n            <h3 class=\"text-sm font-bold text-white mb-2\" data-kid=\"51\">Aerospace</h3>\n            <p class=\"text-xs phosphor-muted\" data-kid=\"52\">Flight mechanics, 3D CAD modeling, and CFD simulations.</p>\n          </div>\n          <div class=\"p-8 border border-sensor/20 hover:border-sensor/50 transition-all bg-optical/30\" data-kid=\"53\">\n            <i class=\"fa-solid fa-microchip text-target text-2xl mb-4\" data-kid=\"54\"></i>\n            <h3 class=\"text-sm font-bold text-white mb-2\" data-kid=\"55\">Hardware</h3>\n            <p class=\"text-xs phosphor-muted\" data-kid=\"56\">Embedded systems, custom drone builds, and circuit design.</p>\n          </div>\n          <div class=\"p-8 border border-sensor/20 hover:border-sensor/50 transition-all bg-optical/30 sm:col-span-2\" data-kid=\"57\">\n            <i class=\"fa-solid fa-code text-target text-2xl mb-4\" data-kid=\"58\"></i>\n            <h3 class=\"text-sm font-bold text-white mb-2\" data-kid=\"59\">Software & AI</h3>\n            <p class=\"text-xs phosphor-muted\" data-kid=\"60\">Full-stack development and local LLM deployment (Ollama, Llama 3) for edge computing.</p>\n          </div>\n        </div>\n      </div>\n    </div>\n  </section>\n\n  \n  <section id=\"skills\" class=\"py-24\" data-kid=\"61\">\n    <div class=\"max-w-7xl mx-auto px-6\" data-kid=\"62\">\n      <div class=\"mb-16\" data-kid=\"63\">\n        <h2 class=\"text-3xl font-bold flex items-center\" data-kid=\"64\">\n          <span class=\"section-index\" data-kid=\"65\">02.</span> Skills Arsenal\n        </h2>\n        <div class=\"h-px-fade mt-4\" data-kid=\"66\"></div>\n      </div>\n\n      <div class=\"grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-8\" data-kid=\"67\">\n        \n        <div class=\"target-box p-8 border border-sensor/10 bg-optical/20\" data-kid=\"68\">\n          <h3 class=\"text-sm font-bold text-white mb-6 border-b border-sensor/20 pb-2\" data-kid=\"69\">Hardware & Embedded</h3>\n          <div class=\"flex flex-wrap gap-2\" data-kid=\"70\">\n            <span class=\"px-2 py-1 border border-sensor/20 text-[10px] text-target font-mono\" data-kid=\"71\">ESP32</span>\n            <span class=\"px-2 py-1 border border-sensor/20 text-[10px] text-target font-mono\" data-kid=\"72\">Arduino</span>\n            <span class=\"px-2 py-1 border border-sensor/20 text-[10px] text-target font-mono\" data-kid=\"73\">Drone Assembly</span>\n            <span class=\"px-2 py-1 border border-sensor/20 text-[10px] text-target font-mono\" data-kid=\"74\">Circuit Design</span>\n            <span class=\"px-2 py-1 border border-sensor/20 text-[10px] text-target font-mono\" data-kid=\"75\">Flight Controllers</span>\n          </div>\n        </div>\n        <div class=\"target-box p-8 border border-sensor/10 bg-optical/20\" data-kid=\"76\">\n          <h3 class=\"text-sm font-bold text-white mb-6 border-b border-sensor/20 pb-2\" data-kid=\"77\">Software Dev</h3>\n          <div class=\"flex flex-wrap gap-2\" data-kid=\"78\">\n            <span class=\"px-2 py-1 border border-sensor/20 text-[10px] text-target font-mono\" data-kid=\"79\">Python</span>\n            <span class=\"px-2 py-1 border border-sensor/20 text-[10px] text-target font-mono\" data-kid=\"80\">React</span>\n            <span class=\"px-2 py-1 border border-sensor/20 text-[10px] text-target font-mono\" data-kid=\"81\">Node.js</span>\n            <span class=\"px-2 py-1 border border-sensor/20 text-[10px] text-target font-mono\" data-kid=\"82\">Firebase</span>\n            <span class=\"px-2 py-1 border border-sensor/20 text-[10px] text-target font-mono\" data-kid=\"83\">Git/GitHub</span>\n          </div>\n        </div>\n        <div class=\"target-box p-8 border border-sensor/10 bg-optical/20\" data-kid=\"84\">\n          <h3 class=\"text-sm font-bold text-white mb-6 border-b border-sensor/20 pb-2\" data-kid=\"85\">Engineering Tools</h3>\n          <div class=\"flex flex-wrap gap-2\" data-kid=\"86\">\n            <span class=\"px-2 py-1 border border-sensor/20 text-[10px] text-target font-mono\" data-kid=\"87\">CATIA V5</span>\n            <span class=\"px-2 py-1 border border-sensor/20 text-[10px] text-target font-mono\" data-kid=\"88\">Ansys</span>\n            <span class=\"px-2 py-1 border border-sensor/20 text-[10px] text-target font-mono\" data-kid=\"89\">Fusion 360</span>\n            <span class=\"px-2 py-1 border border-sensor/20 text-[10px] text-target font-mono\" data-kid=\"90\">MATLAB</span>\n          </div>\n        </div>\n        <div class=\"target-box p-8 border border-sensor/10 bg-optical/20\" data-kid=\"91\">\n          <h3 class=\"text-sm font-bold text-white mb-6 border-b border-sensor/20 pb-2\" data-kid=\"92\">AI & Security</h3>\n          <div class=\"flex flex-wrap gap-2\" data-kid=\"93\">\n            <span class=\"px-2 py-1 border border-sensor/20 text-[10px] text-target font-mono\" data-kid=\"94\">Local LLMs</span>\n            <span class=\"px-2 py-1 border border-sensor/20 text-[10px] text-target font-mono\" data-kid=\"95\">Ollama</span>\n            <span class=\"px-2 py-1 border border-sensor/20 text-[10px] text-target font-mono\" data-kid=\"96\">Llama 3</span>\n            <span class=\"px-2 py-1 border border-sensor/20 text-[10px] text-target font-mono\" data-kid=\"97\">NIDS</span>\n          </div>\n        </div>\n      </div>\n    </div>\n  </section>\n\n  \n  <section id=\"projects\" class=\"py-24 bg-optical/10 border-y border-sensor/5\" data-kid=\"98\">\n    <div class=\"max-w-7xl mx-auto px-6\" data-kid=\"99\">\n      <div class=\"flex flex-col md:flex-row md:items-end justify-between gap-8 mb-16\" data-kid=\"100\">\n        <div data-kid=\"101\">\n          <h2 class=\"text-3xl font-bold flex items-center\" data-kid=\"102\">\n            <span class=\"section-index\" data-kid=\"103\">03.</span> Operations\n          </h2>\n          <div class=\"h-px-fade mt-4\" data-kid=\"104\"></div>\n        </div>\n        <div class=\"flex flex-wrap gap-3\" data-kid=\"105\">\n          <button class=\"px-4 py-2 bg-target text-white text-xs font-bold uppercase tracking-widest\" data-kid=\"106\">All</button>\n          <button class=\"px-4 py-2 border border-sensor/20 phosphor-muted text-xs uppercase tracking-widest hover:text-target hover:border-target transition-all\" data-kid=\"107\">Aerospace</button>\n          <button class=\"px-4 py-2 border border-sensor/20 phosphor-muted text-xs uppercase tracking-widest hover:text-target hover:border-target transition-all\" data-kid=\"108\">Hardware</button>\n        </div>\n      </div>\n\n      <div class=\"grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8\" data-kid=\"109\">\n        \n        <div class=\"target-box group h-full flex flex-col bg-optical/30\" data-kid=\"110\">\n          <div class=\"h-48 border-b border-sensor/10 flex items-center justify-center bg-void/50\" data-kid=\"111\">\n            <span class=\"text-[10px] phosphor-muted uppercase tracking-[0.3em]\" data-kid=\"112\">AEROSPACE_SIM_01</span>\n          </div>\n          <div class=\"p-8 flex flex-col flex-grow\" data-kid=\"113\">\n            <h3 class=\"text-lg font-bold text-white mb-4 group-hover:text-target transition-colors\" data-kid=\"114\">Boeing Aeromodelling</h3>\n            <p class=\"text-sm phosphor-muted leading-relaxed mb-6 flex-grow\" data-kid=\"115\">\n              Led Team Wingineers in designing and building a competitive RC aircraft, optimizing for payload capacity and flight stability.\n            </p>\n            <div class=\"flex flex-wrap gap-2 mb-8\" data-kid=\"116\">\n              <span class=\"text-[9px] uppercase font-mono px-2 py-1 border border-sensor/10 text-sensor/60\" data-kid=\"117\">Aerodynamics</span>\n              <span class=\"text-[9px] uppercase font-mono px-2 py-1 border border-sensor/10 text-sensor/60\" data-kid=\"118\">Leadership</span>\n            </div>\n            <div class=\"mt-auto pt-6 border-t border-sensor/10 flex items-center justify-between\" data-kid=\"119\">\n              <span class=\"text-[10px] text-target uppercase tracking-widest opacity-0 group-hover:opacity-100 transition-opacity\" data-kid=\"120\">Access Log →</span>\n              <i class=\"fa-brands fa-github text-phosphor/40 hover:text-target transition-colors cursor-pointer\" data-kid=\"121\"></i>\n            </div>\n          </div>\n        </div>\n\n        <div class=\"target-box group h-full flex flex-col bg-optical/30\" data-kid=\"122\">\n          <div class=\"h-48 border-b border-sensor/10 flex items-center justify-center bg-void/50\" data-kid=\"123\">\n            <span class=\"text-[10px] phosphor-muted uppercase tracking-[0.3em]\" data-kid=\"124\">HARDWARE_NODE_04</span>\n          </div>\n          <div class=\"p-8 flex flex-col flex-grow\" data-kid=\"125\">\n            <h3 class=\"text-lg font-bold text-white mb-4 group-hover:text-target transition-colors\" data-kid=\"126\">Wi-Fi Sentinel (NIDS)</h3>\n            <p class=\"text-sm phosphor-muted leading-relaxed mb-6 flex-grow\" data-kid=\"127\">\n              Network Intrusion Detection System built with ESP32 to monitor local network traffic and identify anomalous patterns.\n            </p>\n            <div class=\"flex flex-wrap gap-2 mb-8\" data-kid=\"128\">\n              <span class=\"text-[9px] uppercase font-mono px-2 py-1 border border-sensor/10 text-sensor/60\" data-kid=\"129\">ESP32</span>\n              <span class=\"text-[9px] uppercase font-mono px-2 py-1 border border-sensor/10 text-sensor/60\" data-kid=\"130\">Security</span>\n            </div>\n            <div class=\"mt-auto pt-6 border-t border-sensor/10 flex items-center justify-between\" data-kid=\"131\">\n              <span class=\"text-[10px] text-target uppercase tracking-widest opacity-0 group-hover:opacity-100 transition-opacity\" data-kid=\"132\">Access Log →</span>\n              <i class=\"fa-brands fa-github text-phosphor/40 hover:text-target transition-colors cursor-pointer\" data-kid=\"133\"></i>\n            </div>\n          </div>\n        </div>\n\n        <div class=\"target-box group h-full flex flex-col bg-optical/30\" data-kid=\"134\">\n          <div class=\"h-48 border-b border-sensor/10 flex items-center justify-center bg-void/50\" data-kid=\"135\">\n            <span class=\"text-[10px] phosphor-muted uppercase tracking-[0.3em]\" data-kid=\"136\">AI_INFRA_06</span>\n          </div>\n          <div class=\"p-8 flex flex-col flex-grow\" data-kid=\"137\">\n            <h3 class=\"text-lg font-bold text-white mb-4 group-hover:text-target transition-colors\" data-kid=\"138\">Local AI Infrastructure</h3>\n            <p class=\"text-sm phosphor-muted leading-relaxed mb-6 flex-grow\" data-kid=\"139\">\n              Deployed Ollama and Llama 3 models on personal hardware to enable completely offline, private AI inference pipelines.\n            </p>\n            <div class=\"flex flex-wrap gap-2 mb-8\" data-kid=\"140\">\n              <span class=\"text-[9px] uppercase font-mono px-2 py-1 border border-sensor/10 text-sensor/60\" data-kid=\"141\">Ollama</span>\n              <span class=\"text-[9px] uppercase font-mono px-2 py-1 border border-sensor/10 text-sensor/60\" data-kid=\"142\">Llama 3</span>\n            </div>\n            <div class=\"mt-auto pt-6 border-t border-sensor/10 flex items-center justify-between\" data-kid=\"143\">\n              <span class=\"text-[10px] text-target uppercase tracking-widest opacity-0 group-hover:opacity-100 transition-opacity\" data-kid=\"144\">Access Log →</span>\n              <i class=\"fa-brands fa-github text-phosphor/40 hover:text-target transition-colors cursor-pointer\" data-kid=\"145\"></i>\n            </div>\n          </div>\n        </div>\n      </div>\n    </div>\n  </section>\n\n  \n  <section id=\"contact\" class=\"py-32 relative\" data-kid=\"146\">\n    <div class=\"absolute top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 w-full max-w-2xl h-96 bg-target/5 blur-[120px] pointer-events-none\" data-kid=\"147\"></div>\n    \n    <div class=\"max-w-4xl mx-auto px-6 relative z-10 text-center\" data-kid=\"148\">\n      <div class=\"mb-16\" data-kid=\"149\">\n        <h2 class=\"text-xl font-bold text-target mb-4 tracking-[0.3em]\" data-kid=\"150\">04. WHAT'S NEXT?</h2>\n        <h3 class=\"text-5xl md:text-6xl font-bold text-white mb-8\" data-kid=\"151\">Establish Uplink</h3>\n        <p class=\"text-lg phosphor-muted max-w-2xl mx-auto mb-12\" data-kid=\"152\">\n          Whether you're looking to collaborate on drone tech, local AI systems, or just want to talk aerospace, I'm ready for the transmission.\n        </p>\n      </div>\n\n      <div class=\"target-box p-12 bg-optical/40 border border-sensor/10 max-w-3xl mx-auto\" data-kid=\"153\">\n        <form class=\"space-y-8 text-left\" data-kid=\"154\">\n          <div class=\"grid grid-cols-1 md:grid-cols-2 gap-8\" data-kid=\"155\">\n            <div class=\"space-y-2\" data-kid=\"156\">\n              <label class=\"text-[10px] uppercase tracking-widest text-sensor/60\" data-kid=\"157\">ID / Name</label>\n              <input type=\"text\" placeholder=\"Entity Name\" class=\"w-full bg-void border border-sensor/20 px-4 py-3 text-sm focus:border-target outline-none transition-all placeholder:text-phosphor/20\" data-kid=\"158\">\n            </div>\n            <div class=\"space-y-2\" data-kid=\"159\">\n              <label class=\"text-[10px] uppercase tracking-widest text-sensor/60\" data-kid=\"160\">Frequency / Email</label>\n              <input type=\"email\" placeholder=\"contact@uplink.io\" class=\"w-full bg-void border border-sensor/20 px-4 py-3 text-sm focus:border-target outline-none transition-all placeholder:text-phosphor/20\" data-kid=\"161\">\n            </div>\n          </div>\n          <div class=\"space-y-2\" data-kid=\"162\">\n            <label class=\"text-[10px] uppercase tracking-widest text-sensor/60\" data-kid=\"163\">Payload / Message</label>\n            <textarea rows=\"4\" placeholder=\"Transmission details...\" class=\"w-full bg-void border border-sensor/20 px-4 py-3 text-sm focus:border-target outline-none transition-all resize-none placeholder:text-phosphor/20\" data-kid=\"164\"></textarea>\n          </div>\n          <button type=\"button\" class=\"btn-hud py-4 px-12 w-full md:w-auto\" data-kid=\"165\">Transmit Signal</button>\n        </form>\n      </div>\n\n      <div class=\"mt-20\" data-kid=\"166\">\n        <a href=\"mailto:prasun.oct27@gmail.com\" class=\"text-sensor hover:text-target transition-colors font-mono tracking-widest\" data-kid=\"167\">\n          PRASUN.OCT27@GMAIL.COM\n        </a>\n      </div>\n    </div>\n  </section>\n\n  \n  <footer class=\"py-12 border-t border-sensor/5\" data-kid=\"168\">\n    <div class=\"max-w-7xl mx-auto px-6 flex flex-col md:flex-row items-center justify-between gap-6\" data-kid=\"169\">\n      <div class=\"text-[10px] phosphor-muted uppercase tracking-[0.4em]\" data-kid=\"170\">\n        &copy; 2026 PRASUN KUMAR BISWAS // BUILD_VER_1.0.4\n      </div>\n      <div class=\"flex items-center gap-8\" data-kid=\"171\">\n        <a href=\"#\" class=\"text-phosphor/40 hover:text-sensor transition-colors\" data-kid=\"172\"><i class=\"fa-brands fa-github text-xl\" data-kid=\"173\"></i></a>\n        <a href=\"#\" class=\"text-phosphor/40 hover:text-sensor transition-colors\" data-kid=\"174\"><i class=\"fa-brands fa-linkedin text-xl\" data-kid=\"175\"></i></a>\n        <a href=\"#\" class=\"text-phosphor/40 hover:text-sensor transition-colors\" data-kid=\"176\"><i class=\"fa-brands fa-twitter text-xl\" data-kid=\"177\"></i></a>\n      </div>\n    </div>\n  </footer>\n</div>\n\n<link rel=\"stylesheet\" href=\"https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css\" data-kid=\"178\">",
