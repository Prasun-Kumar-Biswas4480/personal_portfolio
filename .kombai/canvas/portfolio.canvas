hor/60\" data-kid=\"114\">\n              <li data-kid=\"115\">> PYTHON_ENG</li>\n              <li data-kid=\"116\">> REACT_JS_V19</li>\n              <li data-kid=\"117\">> NODE_JS_RT</li>\n              <li data-kid=\"118\">> FIREBASE_DB</li>\n            </ul>\n          </div>\n          <div data-kid=\"119\">\n            <div class=\"text-sensor font-heading text-xs mb-4\" data-kid=\"120\">AI_VECTORS</div>\n            <ul class=\"font-mono text-xs space-y-2 text-phosphor/60\" data-kid=\"121\">\n              <li data-kid=\"122\">> OLLAMA_LLM</li>\n              <li data-kid=\"123\">> LLAMA_3_INF</li>\n              <li data-kid=\"124\">> EDGE_COMPUTE</li>\n              <li data-kid=\"125\">> SEC_DIAG</li>\n            </ul>\n          </div>\n        </div>\n      </div>\n    </div>\n  </section>\n\n  \n  <footer class=\"py-12 border-t border-white/5 bg-void/50 backdrop-blur-sm\" data-kid=\"126\">\n    <div class=\"max-w-7xl mx-auto px-6 flex flex-col md:flex-row items-center justify-between gap-8\" data-kid=\"127\">\n      <div class=\"font-mono text-[10px] text-phosphor/30 uppercase tracking-[0.2em]\" data-kid=\"128\">\n        &copy; 2024 PRASUN_PORTFOLIO_V4.0 // ALL_DATA_SECURED\n      </div>\n      <div class=\"flex gap-6 font-mono text-xs\" data-kid=\"129\">\n        <a href=\"#\" class=\"text-phosphor/60 hover:text-sensor transition-colors tracking-widest\" data-kid=\"130\">GITHUB</a>\n        <a href=\"#\" class=\"text-phosphor/60 hover:text-sensor transition-colors tracking-widest\" data-kid=\"131\">LINKEDIN</a>\n        <a href=\"#\" class=\"text-phosphor/60 hover:text-sensor transition-colors tracking-widest\" data-kid=\"132\">EMAIL_UPLINK</a>\n      </div>\n    </div>\n  </footer>\n</div>\n\n<link rel=\"stylesheet\" href=\"https://cdn.jsdelivr.net/npm/@tabler/icons-webfont/tabler-icons.min.css\" data-kid=\"133\">\n<script src=\"https://cdn.jsdelivr.net/npm/gsap@3/dist/gsap.min.js\" data-kid=\"134\"></script>\n<script data-kid=\"135\">\n  // Simple entry animation for glass panels\n  window.addEventListener('load', () => {\n    gsap.from(\".liquid-glass\", {\n      opacity: 0,\n      y: 40,\n      stagger: 0.1,\n      duration: 1,\n      ease: \"power3.out\"\n    });\n  });\n</script>",
