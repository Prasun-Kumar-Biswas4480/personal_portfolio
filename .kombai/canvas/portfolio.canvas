      "html": "<style data-kid=\"0\">\n  @import url('https://fonts.googleapis.com/css2?family=Michroma&family=Share+Tech+Mono&display=swap');\n  @import url('https://cdn.jsdelivr.net/npm/@tabler/icons-webfont/tabler-icons.min.css');\n\n  :root {\n    --color-void: #000000;\n    --color-optical: #050505;\n    --color-phosphor: #E0E0E0;\n    --color-target: #FF003C;\n    --color-radar: #FFB000;\n    --color-sensor: #00E5FF;\n    --font-heading: 'Michroma', sans-serif;\n    --font-mono: 'Share Tech Mono', monospace;\n  }\n\n  body {\n    background-color: var(--color-void);\n    color: var(--color-phosphor);\n    font-family: var(--font-mono);\n    margin: 0;\n    overflow-x: hidden;\n    cursor: crosshair;\n  }\n\n  .font-heading { font-family: var(--font-heading); }\n  .font-mono { font-family: var(--font-mono); }\n\n  /* CRT Scanlines Overlay */\n  .scanlines {\n    position: fixed;\n    top: 0;\n    left: 0;\n    width: 100vw;\n    height: 100vh;\n    pointer-events: none;\n    z-index: 100;\n    background: repeating-linear-gradient(\n      to bottom,\n      rgba(255, 255, 255, 0),\n      rgba(255, 255, 255, 0) 2px,\n      rgba(0, 0, 0, 0.2) 2px,\n      rgba(0, 0, 0, 0.2) 4px\n    );\n    opacity: 0.15;\n    mix-blend-mode: overlay;\n  }\n\n  /* Target Box Utility */\n  .target-box {\n    position: relative;\n    background: transparent;\n    transition: all 0.3s ease;\n    background: \n      linear-gradient(to right, var(--color-sensor) 2px, transparent 2px) 0 0,\n      linear-gradient(to bottom, var(--color-sensor) 2px, transparent 2px) 0 0,\n      linear-gradient(to left, var(--color-sensor) 2px, transparent 2px) 100% 0,\n      linear-gradient(to bottom, var(--color-sensor) 2px, transparent 2px) 100% 0,\n      linear-gradient(to right, var(--color-sensor) 2px, transparent 2px) 0 100%,\n      linear-gradient(to top, var(--color-sensor) 2px, transparent 2px) 0 100%,\n      linear-gradient(to left, var(--color-sensor) 2px, transparent 2px) 100% 100%,\n      linear-gradient(to top, var(--color-sensor) 2px, transparent 2px) 100% 100%;\n    background-repeat: no-repeat;\n    background-size: 16px 16px;\n  }\n\n  .target-box:hover {\n    transform: scale(1.02);\n    box-shadow: inset 0 0 20px rgba(255, 0, 60, 0.05);\n    background: \n      linear-gradient(to right, var(--color-target) 2px, transparent 2px) 0 0,\n      linear-gradient(to bottom, var(--color-target) 2px, transparent 2px) 0 0,\n      linear-gradient(to left, var(--color-target) 2px, transparent 2px) 100% 0,\n      linear-gradient(to bottom, var(--color-target) 2px, transparent 2px) 100% 0,\n      linear-gradient(to right, var(--color-target) 2px, transparent 2px) 0 100%,\n      linear-gradient(to top, var(--color-target) 2px, transparent 2px) 0 100%,\n      linear-gradient(to left, var(--color-target) 2px, transparent 2px) 100% 100%,\n      linear-gradient(to top, var(--color-target) 2px, transparent 2px) 100% 100%;\n    background-repeat: no-repeat;\n    background-size: 24px 24px;\n  }\n\n  /* Liquid Glass Effect */\n  .liquid-glass {\n    backdrop-filter: blur(24px);\n    -webkit-backdrop-filter: blur(24px);\n    background-color: rgba(5, 5, 5, 0.4);\n    box-shadow: inset 0 1px 0 rgba(0, 229, 255, 0.3);\n    border: 1px solid rgba(0, 229, 255, 0.1);\n  }\n\n  /* Animated Fluid Orbs */\n  .orb {\n    position: absolute;\n    border-radius: 50%;\n    filter: blur(100px);\n    opacity: 0.3;\n    z-index: -1;\n    pointer-events: none;\n    animation: float 20s infinite alternate ease-in-out;\n  }\n\n  @keyframes float {\n    0% { transform: translate(0, 0) scale(1); }\n    100% { transform: translate(100px, 100px) scale(1.2); }\n  }\n\n  .orb-1 { width: 600px; height: 600px; background: var(--color-sensor); top: -10%; left: -10%; }\n  .orb-2 { width: 500px; height: 500px; background: #0088ff; bottom: 20%; right: -5%; animation-delay: -5s; }\n  .orb-3 { width: 400px; height: 400px; background: var(--color-sensor); top: 40%; left: 30%; animation-delay: -10s; }\n\n  .btn-hud {\n    display: inline-flex;\n    align-items: center;\n    justify-content: center;\n    padding: 0.5rem 1.5rem;\n    border: 1px solid var(--color-sensor);\n    color: var(--color-sensor);\n    background: transparent;\n    font-family: var(--font-mono);\n    text-transform: uppercase;\n    letter-spacing: 0.1em;\n    font-size: 0.875rem;\n    transition: all 0.3s ease;\n    text-decoration: none;\n  }\n\n  .btn-hud:hover {\n    background: rgba(255, 0, 60, 0.1);\n    border-color: var(--color-target);\n    color: var(--color-target);\n  }\n\n  /* Custom Scrollbar */\n  ::-webkit-scrollbar { width: 4px; }\n  ::-webkit-scrollbar-track { background: var(--color-void); }\n  ::-webkit-scrollbar-thumb { background: var(--color-sensor); }\n  ::-webkit-scrollbar-thumb:hover { background: var(--color-target); }\n</style>\n\n<div class=\"scanlines\" data-kid=\"1\"></div>\n\n\n<div class=\"orb orb-1\" data-kid=\"2\"></div>\n<div class=\"orb orb-2\" data-kid=\"3\"></div>\n<div class=\"orb orb-3\" data-kid=\"4\"></div>\n\n\n<nav class=\"fixed top-0 w-full z-50 px-8 py-6 backdrop-blur-md border-b border-sensor/10\" data-kid=\"5\">\n  <div class=\"max-w-7xl mx-auto flex justify-between items-center\" data-kid=\"6\">\n    <div class=\"flex items-center gap-2\" data-kid=\"7\">\n      <div class=\"w-8 h-8 target-box flex items-center justify-center\" data-kid=\"8\">\n        <i class=\"ti ti-cpu text-sensor text-lg\" data-kid=\"9\"></i>\n      </div>\n      <span class=\"font-heading text-sensor tracking-[0.2em]\" data-kid=\"10\">MISSION_CTRL</span>\n    </div>\n    <div class=\"hidden md:flex items-center gap-8 text-xs tracking-widest uppercase\" data-kid=\"11\">\n      <a href=\"#\" class=\"hover:text-target transition-colors\" data-kid=\"12\">01_BIOGRAPHY</a>\n      <a href=\"#\" class=\"hover:text-target transition-colors\" data-kid=\"13\">02_ARSENAL</a>\n      <a href=\"#\" class=\"hover:text-target transition-colors text-sensor border-b border-sensor\" data-kid=\"14\">03_OPERATIONS</a>\n      <a href=\"#\" class=\"hover:text-target transition-colors\" data-kid=\"15\">04_UPLINK</a>\n    </div>\n  </div>\n</nav>\n\n\n<section class=\"min-h-screen flex flex-col items-center justify-center pt-20 px-4 text-center relative\" data-kid=\"16\">\n  <div class=\"absolute inset-0 flex items-center justify-center pointer-events-none opacity-20\" data-kid=\"17\">\n    <img src=\"https://cdn.jsdelivr.net/npm/game-icons-transparent@latest/svgs/delapouite/crosshair.svg\" class=\"w-[600px] h-[600px] animate-[spin_60s_linear_infinite]\" style=\"filter: invert(1) sepia(1) saturate(5) hue-rotate(150deg);\" data-kid=\"18\">\n  </div>\n  \n  <div class=\"relative z-10\" data-kid=\"19\">\n    <div class=\"mb-4 text-target font-mono text-sm tracking-widest animate-pulse\" data-kid=\"20\">\n      SYSTEM.INITIALIZE // PORTFOLIO_V2.0\n    </div>\n    <h1 class=\"font-heading text-5xl md:text-7xl mb-6 tracking-[0.3em] text-sensor drop-shadow-[0_0_15px_rgba(0,229,255,0.4)]\" data-kid=\"21\">\n      PRASUN_KUMAR\n    </h1>\n    <p class=\"max-w-2xl mx-auto text-phosphor/60 text-lg mb-10 leading-relaxed\" data-kid=\"22\">\n      AEROSPACE ENGINEER // FULL-STACK DEVELOPER // AI SYSTEMS ARCHITECT\n      <br data-kid=\"23\">\n      <span class=\"text-xs tracking-widest opacity-40 mt-2 block\" data-kid=\"24\">LAT: 20.2961° N // LONG: 85.8245° E</span>\n    </p>\n    <div class=\"flex flex-wrap justify-center gap-4\" data-kid=\"25\">\n      <a href=\"#projects\" class=\"btn-hud\" data-kid=\"26\">ENGAGE OPTICS</a>\n      <a href=\"#\" class=\"btn-hud !border-phosphor/20 !text-phosphor/40\" data-kid=\"27\">SECURE_CV.PDF</a>\n    </div>\n  </div>\n</section>\n\n\n<section id=\"projects\" class=\"py-32 px-4 md:px-12 max-w-7xl mx-auto\" data-kid=\"28\">\n  <div class=\"mb-20\" data-kid=\"29\">\n    <h2 class=\"font-heading text-3xl mb-4 tracking-widest inline-flex items-center\" data-kid=\"30\">\n      <span class=\"text-target mr-4\" data-kid=\"31\">03.</span> ACTIVE_OPERATIONS\n    </h2>\n    <div class=\"h-px bg-sensor/20 w-full max-w-md\" data-kid=\"32\"></div>\n  </div>\n\n  \n  <div class=\"grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8\" data-kid=\"33\">\n    \n    \n    <div class=\"target-box liquid-glass p-1 flex flex-col group cursor-pointer\" data-kid=\"34\">\n      <div class=\"relative h-48 overflow-hidden mb-6 border-b border-sensor/10\" data-kid=\"35\">\n        <div class=\"absolute inset-0 bg-sensor/5 group-hover:bg-target/5 transition-colors duration-500\" data-kid=\"36\"></div>\n        <img src=\"https://images.unsplash.com/photo-1709990740078-05aa8ee5b9b7?auto=format&w=600&q=80&fit=crop\" class=\"w-full h-full object-cover opacity-40 group-hover:opacity-60 transition-all duration-700 group-hover:scale-110\" loading=\"lazy\" decoding=\"async\" data-kid=\"37\">\n        <div class=\"absolute top-4 right-4 text-[10px] font-mono bg-void/80 px-2 py-1 border border-sensor/30 text-sensor\" data-kid=\"38\">\n          LVL_01\n        </div>\n      </div>\n      \n      <div class=\"p-6 pt-0 flex flex-col flex-grow\" data-kid=\"39\">\n        <div class=\"flex justify-between items-start mb-4\" data-kid=\"40\">\n          <h3 class=\"font-heading text-lg text-white group-hover:text-target transition-colors tracking-wider\" data-kid=\"41\">\n            BOEING_AERO\n          </h3>\n          <i class=\"ti ti-arrows-diagonal text-sensor/40 group-hover:text-target\" data-kid=\"42\"></i>\n        </div>\n        \n        <p class=\"text-phosphor/60 text-sm mb-6 leading-relaxed\" data-kid=\"43\">\n          Led Team Wingineers in designing and building a competitive RC aircraft, optimizing for payload capacity and flight stability.\n        </p>\n        \n        <div class=\"mt-auto\" data-kid=\"44\">\n          <div class=\"flex flex-wrap gap-2 mb-6\" data-kid=\"45\">\n            <span class=\"px-2 py-1 text-[10px] border border-sensor/20 text-sensor/60 font-mono\" data-kid=\"46\">AERODYNAMICS</span>\n            <span class=\"px-2 py-1 text-[10px] border border-sensor/20 text-sensor/60 font-mono\" data-kid=\"47\">RC_SYSTEMS</span>\n          </div>\n          <div class=\"flex justify-between items-center pt-4 border-t border-sensor/10\" data-kid=\"48\">\n            <span class=\"text-[10px] text-target font-mono opacity-0 group-hover:opacity-100 transition-opacity\" data-kid=\"49\">\n              VIEW_TELEMETRY →\n            </span>\n            <div class=\"flex gap-3 text-phosphor/40\" data-kid=\"50\">\n              <i class=\"ti ti-brand-github hover:text-sensor\" data-kid=\"51\"></i>\n              <i class=\"ti ti-external-link hover:text-sensor\" data-kid=\"52\"></i>\n            </div>\n          </div>\n        </div>\n      </div>\n    </div>\n\n    \n    <div class=\"target-box liquid-glass p-1 flex flex-col group cursor-pointer md:translate-y-12\" data-kid=\"53\">\n      <div class=\"relative h-48 overflow-hidden mb-6 border-b border-sensor/10\" data-kid=\"54\">\n        <div class=\"absolute inset-0 bg-sensor/5 group-hover:bg-target/5 transition-colors duration-500\" data-kid=\"55\"></div>\n        <img src=\"https://images.unsplash.com/photo-1669295384050-a1d4357bd1d7?auto=format&w=600&q=80&fit=crop\" class=\"w-full h-full object-cover opacity-40 group-hover:opacity-60 transition-all duration-700 group-hover:scale-110\" loading=\"lazy\" decoding=\"async\" data-kid=\"56\">\n        <div class=\"absolute top-4 right-4 text-[10px] font-mono bg-void/80 px-2 py-1 border border-sensor/30 text-sensor\" data-kid=\"57\">\n          LVL_02\n        </div>\n      </div>\n      \n      <div class=\"p-6 pt-0 flex flex-col flex-grow\" data-kid=\"58\">\n        <div class=\"flex justify-between items-start mb-4\" data-kid=\"59\">\n          <h3 class=\"font-heading text-lg text-white group-hover:text-target transition-colors tracking-wider\" data-kid=\"60\">\n            SKY_NODE\n          </h3>\n          <i class=\"ti ti-arrows-diagonal text-sensor/40 group-hover:text-target\" data-kid=\"61\"></i>\n        </div>\n        \n        <p class=\"text-phosphor/60 text-sm mb-6 leading-relaxed\" data-kid=\"62\">\n          Disaster communication payload utilizing LoRa to establish emergency mesh networks when primary infrastructure fails.\n        </p>\n        \n        <div class=\"mt-auto\" data-kid=\"63\">\n          <div class=\"flex flex-wrap gap-2 mb-6\" data-kid=\"64\">\n            <span class=\"px-2 py-1 text-[10px] border border-sensor/20 text-sensor/60 font-mono\" data-kid=\"65\">LoRa</span>\n            <span class=\"px-2 py-1 text-[10px] border border-sensor/20 text-sensor/60 font-mono\" data-kid=\"66\">MESH_NET</span>\n          </div>\n          <div class=\"flex justify-between items-center pt-4 border-t border-sensor/10\" data-kid=\"67\">\n            <span class=\"text-[10px] text-target font-mono opacity-0 group-hover:opacity-100 transition-opacity\" data-kid=\"68\">\n              VIEW_TELEMETRY →\n            </span>\n            <div class=\"flex gap-3 text-phosphor/40\" data-kid=\"69\">\n              <i class=\"ti ti-brand-github hover:text-sensor\" data-kid=\"70\"></i>\n              <i class=\"ti ti-external-link hover:text-sensor\" data-kid=\"71\"></i>\n            </div>\n          </div>\n        </div>\n      </div>\n    </div>\n\n    \n    <div class=\"target-box liquid-glass p-1 flex flex-col group cursor-pointer\" data-kid=\"72\">\n      <div class=\"relative h-48 overflow-hidden mb-6 border-b border-sensor/10\" data-kid=\"73\">\n        <div class=\"absolute inset-0 bg-sensor/5 group-hover:bg-target/5 transition-colors duration-500\" data-kid=\"74\"></div>\n        <img src=\"https://images.unsplash.com/photo-1708778002477-75611274f23d?auto=format&w=600&q=80&fit=crop\" class=\"w-full h-full object-cover opacity-40 group-hover:opacity-60 transition-all duration-700 group-hover:scale-110\" loading=\"lazy\" decoding=\"async\" data-kid=\"75\">\n        <div class=\"absolute top-4 right-4 text-[10px] font-mono bg-void/80 px-2 py-1 border border-sensor/30 text-sensor\" data-kid=\"76\">\n          LVL_03\n        </div>\n      </div>\n      \n      <div class=\"p-6 pt-0 flex flex-col flex-grow\" data-kid=\"77\">\n        <div class=\"flex justify-between items-start mb-4\" data-kid=\"78\">\n          <h3 class=\"font-heading text-lg text-white group-hover:text-target transition-colors tracking-wider\" data-kid=\"79\">\n            LOCAL_AI_INFRA\n          </h3>\n          <i class=\"ti ti-arrows-diagonal text-sensor/40 group-hover:text-target\" data-kid=\"80\"></i>\n        </div>\n        \n        <p class=\"text-phosphor/60 text-sm mb-6 leading-relaxed\" data-kid=\"81\">\n          Deployed Ollama and Llama 3 models on personal hardware to enable completely offline, private AI inference pipelines.\n        </p>\n        \n        <div class=\"mt-auto\" data-kid=\"82\">\n          <div class=\"flex flex-wrap gap-2 mb-6\" data-kid=\"83\">\n            <span class=\"px-2 py-1 text-[10px] border border-sensor/20 text-sensor/60 font-mono\" data-kid=\"84\">LLAMA_3</span>\n            <span class=\"px-2 py-1 text-[10px] border border-sensor/20 text-sensor/60 font-mono\" data-kid=\"85\">EDGE_AI</span>\n          </div>\n          <div class=\"flex justify-between items-center pt-4 border-t border-sensor/10\" data-kid=\"86\">\n            <span class=\"text-[10px] text-target font-mono opacity-0 group-hover:opacity-100 transition-opacity\" data-kid=\"87\">\n              VIEW_TELEMETRY →\n            </span>\n            <div class=\"flex gap-3 text-phosphor/40\" data-kid=\"88\">\n              <i class=\"ti ti-brand-github hover:text-sensor\" data-kid=\"89\"></i>\n              <i class=\"ti ti-external-link hover:text-sensor\" data-kid=\"90\"></i>\n            </div>\n          </div>\n        </div>\n      </div>\n    </div>\n  </div>\n</section>\n\n\n<footer class=\"mt-32 border-t border-sensor/20 bg-void/80 backdrop-blur-xl relative z-10\" data-kid=\"91\">\n  <div class=\"max-w-7xl mx-auto px-8 py-12\" data-kid=\"92\">\n    <div class=\"grid grid-cols-1 md:grid-cols-4 gap-12 mb-12\" data-kid=\"93\">\n      <div class=\"md:col-span-2\" data-kid=\"94\">\n        <h4 class=\"font-heading text-sensor mb-6 text-sm tracking-[0.2em]\" data-kid=\"95\">TERMINAL_DIAGNOSTICS</h4>\n        <div class=\"font-mono text-[10px] text-phosphor/40 space-y-1\" data-kid=\"96\">\n          <p data-kid=\"97\">> SYS_STATUS: OPERATIONAL</p>\n          <p data-kid=\"98\">> CONNECTION: ENCRYPTED_TLS_1.3</p>\n          <p data-kid=\"99\">> UPTIME: 14:02:44:09</p>\n          <p class=\"animate-pulse\" data-kid=\"100\">> WAITING_FOR_UPLINK...</p>\n        </div>\n      </div>\n      <div data-kid=\"101\">\n        <h4 class=\"font-heading text-phosphor mb-6 text-xs tracking-widest\" data-kid=\"102\">TRANSMISSIONS</h4>\n        <ul class=\"text-xs space-y-4 font-mono\" data-kid=\"103\">\n          <li data-kid=\"104\"><a href=\"#\" class=\"hover:text-target transition-colors flex items-center gap-2\" data-kid=\"105\"><i class=\"ti ti-brand-github\" data-kid=\"106\"></i> GITHUB_SRV</a></li>\n          <li data-kid=\"107\"><a href=\"#\" class=\"hover:text-target transition-colors flex items-center gap-2\" data-kid=\"108\"><i class=\"ti ti-brand-linkedin\" data-kid=\"109\"></i> LINKEDIN_NODE</a></li>\n          <li data-kid=\"110\"><a href=\"#\" class=\"hover:text-target transition-colors flex items-center gap-2\" data-kid=\"111\"><i class=\"ti ti-brand-twitter\" data-kid=\"112\"></i> X_FEED</a></li>\n        </ul>\n      </div>\n      <div data-kid=\"113\">\n        <h4 class=\"font-heading text-phosphor mb-6 text-xs tracking-widest\" data-kid=\"114\">UPLINK</h4>\n        <a href=\"mailto:prasun.oct27@gmail.com\" class=\"btn-hud w-full\" data-kid=\"115\">SEND_SIGNAL</a>\n      </div>\n    </div>\n    <div class=\"flex flex-col md:flex-row justify-between items-center pt-8 border-t border-sensor/10 text-[10px] font-mono text-phosphor/30 tracking-widest\" data-kid=\"116\">\n      <p data-kid=\"117\">© 2024 PRASUN_KUMAR // ALL_RIGHTS_RESERVED</p>\n      <p data-kid=\"118\">BUILT_WITH_REACT_V19 // TAILWIND_V4_HUD</p>\n    </div>\n  </div>\n</footer>\n\n<script data-kid=\"119\">\n  // Simple rotation for the background crosshair if needed\n</script>",
