      "html": "<style data-kid=\"0\">\n  @import url('https://fonts.googleapis.com/css2?family=Michroma&family=Share+Tech+Mono&display=swap');\n\n  :root {\n    --color-void: #000000;\n    --color-optical: #050505;\n    --color-phosphor: #E0E0E0;\n    --color-target: #FF003C;\n    --color-sensor: #00E5FF;\n    --color-radar: #FFB000;\n  }\n\n  body {\n    background-color: var(--color-void);\n    color: var(--color-phosphor);\n    font-family: 'Share Tech Mono', monospace;\n    margin: 0;\n    padding: 20px;\n    display: flex;\n    justify-content: center;\n    align-items: center;\n    min-height: 100vh;\n  }\n\n  .font-heading {\n    font-family: 'Michroma', sans-serif;\n  }\n\n  .target-box {\n    position: relative;\n    background: transparent;\n    transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);\n    background-image: \n      linear-gradient(to right, var(--color-sensor) 2px, transparent 2px),\n      linear-gradient(to bottom, var(--color-sensor) 2px, transparent 2px),\n      linear-gradient(to left, var(--color-sensor) 2px, transparent 2px),\n      linear-gradient(to bottom, var(--color-sensor) 2px, transparent 2px),\n      linear-gradient(to right, var(--color-sensor) 2px, transparent 2px),\n      linear-gradient(to top, var(--color-sensor) 2px, transparent 2px),\n      linear-gradient(to left, var(--color-sensor) 2px, transparent 2px),\n      linear-gradient(to top, var(--color-sensor) 2px, transparent 2px);\n    background-position: 0 0, 0 0, 100% 0, 100% 0, 0 100%, 0 100%, 100% 100%, 100% 100%;\n    background-repeat: no-repeat;\n    background-size: 16px 16px;\n  }\n  \n  .target-box:hover {\n    transform: scale(1.02);\n    background-color: var(--color-optical);\n    box-shadow: inset 0 0 20px rgba(255, 0, 60, 0.05);\n    z-index: 10;\n    background-image: \n      linear-gradient(to right, var(--color-target) 2px, transparent 2px),\n      linear-gradient(to bottom, var(--color-target) 2px, transparent 2px),\n      linear-gradient(to left, var(--color-target) 2px, transparent 2px),\n      linear-gradient(to bottom, var(--color-target) 2px, transparent 2px),\n      linear-gradient(to right, var(--color-target) 2px, transparent 2px),\n      linear-gradient(to top, var(--color-target) 2px, transparent 2px),\n      linear-gradient(to left, var(--color-target) 2px, transparent 2px),\n      linear-gradient(to top, var(--color-target) 2px, transparent 2px);\n    background-size: 24px 24px;\n  }\n\n  .scanlines-overlay {\n    position: fixed;\n    top: 0;\n    left: 0;\n    width: 100%;\n    height: 100%;\n    pointer-events: none;\n    z-index: 50;\n    background: repeating-linear-gradient(\n      to bottom,\n      rgba(255, 255, 255, 0),\n      rgba(255, 255, 255, 0) 2px,\n      rgba(0, 0, 0, 0.2) 2px,\n      rgba(0, 0, 0, 0.2) 4px\n    );\n    opacity: 0.15;\n    mix-blend-mode: overlay;\n  }\n</style>\n\n<div class=\"scanlines-overlay\" data-kid=\"1\"></div>\n\n<div class=\"w-full max-w-[400px]\" data-kid=\"2\">\n  <div class=\"target-box overflow-hidden border border-[#00E5FF1a] hover:border-[#FF003C80] transition-all flex flex-col group cursor-crosshair\" data-kid=\"3\">\n    \n    <div class=\"h-48 bg-transparent border-b border-[#00E5FF33] flex items-center justify-center relative overflow-hidden\" data-kid=\"4\">\n      <div class=\"absolute inset-0 bg-gradient-to-t from-black to-transparent z-10 opacity-60\" data-kid=\"5\"></div>\n      <div class=\"z-0 opacity-20 group-hover:opacity-40 transition-opacity\" data-kid=\"6\">\n        <svg width=\"60\" height=\"60\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"0.5\" stroke-linecap=\"round\" stroke-linejoin=\"round\" class=\"text-[#00E5FF]\" data-kid=\"7\">\n          <path d=\"M12 3v19M3 12h19M12 12m-9 0a9 9 0 1 0 18 0a9 9 0 1 0 -18 0\" data-kid=\"8\"></path>\n        </svg>\n      </div>\n      <span class=\"absolute bottom-4 left-4 font-mono text-[10px] text-[#E0E0E066] z-20 tracking-tighter uppercase\" data-kid=\"9\">\n        Sector: Aerospace // Visual_Stream_01\n      </span>\n    </div>\n    \n    <div class=\"p-6 flex flex-col flex-grow\" data-kid=\"10\">\n      <div class=\"flex justify-between items-start mb-2\" data-kid=\"11\">\n        <h3 class=\"text-lg font-bold text-white group-hover:text-[#FF003C] transition-colors font-heading tracking-wider uppercase\" data-kid=\"12\">\n          Boeing Aeromodelling\n        </h3>\n      </div>\n      \n      <p class=\"text-sm text-[#E0E0E099] mb-4 flex-grow leading-relaxed\" data-kid=\"13\">\n        Led Team Wingineers in designing and building a competitive RC aircraft, optimizing for payload capacity and flight stability.\n      </p>\n      \n      <div class=\"flex flex-wrap gap-2 mb-6\" data-kid=\"14\">\n        <span class=\"px-2 py-0.5 text-[10px] font-mono bg-transparent text-[#E0E0E0CC] border border-[#00E5FF33] tracking-tight uppercase\" data-kid=\"15\">Aerodynamics</span>\n        <span class=\"px-2 py-0.5 text-[10px] font-mono bg-transparent text-[#E0E0E0CC] border border-[#00E5FF33] tracking-tight uppercase\" data-kid=\"16\">RC Aircraft</span>\n        <span class=\"px-2 py-0.5 text-[10px] font-mono bg-transparent text-[#E0E0E0CC] border border-[#00E5FF33] tracking-tight uppercase\" data-kid=\"17\">Structural</span>\n      </div>\n      \n      <div class=\"mt-auto pt-4 border-t border-[#00E5FF1a] flex justify-between items-center\" data-kid=\"18\">\n        <div class=\"flex gap-4\" data-kid=\"19\">\n          <a href=\"#\" class=\"flex items-center text-xs text-[#E0E0E099] hover:text-[#FF003C] transition-colors uppercase tracking-widest\" data-kid=\"20\">\n            <svg class=\"w-3.5 h-3.5 mr-1.5\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" data-kid=\"21\"><path d=\"M9 19c-5 1.5-5-2.5-7-3m14 6v-3.87a3.37 3.37 0 0 0-.94-2.61c3.14-.35 6.44-1.54 6.44-7A5.44 5.44 0 0 0 20 4.77 5.07 5.07 0 0 0 19.91 1S18.73.65 16 2.48a13.38 13.38 0 0 0-7 0C6.27.65 5.09 1 5.09 1A5.07 5.07 0 0 0 5 4.77a5.44 5.44 0 0 0-1.5 3.78c0 5.42 3.3 6.61 6.44 7A3.37 3.37 0 0 0 9 18.13V22\" data-kid=\"22\"></path></svg>\n            Source\n          </a>\n          <a href=\"#\" class=\"flex items-center text-xs text-[#E0E0E099] hover:text-[#FF003C] transition-colors uppercase tracking-widest\" data-kid=\"23\">\n            <svg class=\"w-3.5 h-3.5 mr-1.5\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" data-kid=\"24\"><path d=\"M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6\" data-kid=\"25\"></path><polyline points=\"15 3 21 3 21 9\" data-kid=\"26\"></polyline><line x1=\"10\" y1=\"14\" x2=\"21\" y2=\"3\" data-kid=\"27\"></line></svg>\n            Data\n          </a>\n        </div>\n        <span class=\"text-[10px] text-[#FF003C] font-mono opacity-0 group-hover:opacity-100 transition-opacity tracking-tighter uppercase\" data-kid=\"28\">\n          Access_Granted_\n        </span>\n      </div>\n    </div>\n  </div>\n</div>\n\n<script src=\"https://cdn.jsdelivr.net/npm/lucide@0.344.0/dist/umd/lucide.min.js\" data-kid=\"29\"></script>\n<script data-kid=\"30\">\n  lucide.createIcons();\n</script>",
